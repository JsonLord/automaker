+const fs = require('fs');
+
+let testCode = fs.readFileSync(
+  'apps/server/tests/unit/routes/projects/import-github.test.ts',
+  'utf8'
+);
+
+// I need to use the `const { argusServiceMock, autonomyRunnerMock } = vi.hoisted(...)` output properly.
+// The issue is that the hoisted variables are declared OUTSIDE the tests, but if I redefined them, it broke. Wait.
+// Oh, the first failure: "Failed to initialize Argus for imported project: Error: ARGUS_REGISTRATION_UNVERIFIED".
+// Let's modify the mocks so they do not return "ARGUS_REGISTRATION_UNVERIFIED" error.
+// The `getStatus` mock needs to return `automakerProjectId: 'twenty'` (the default value used in `invoke` if it uses the string 'twenty' or what we provide).
+// Let's see what `projectId` is passed: `import-github.ts` derives `projectId` randomly using `randomUUID()`.
+// Ah! Wait, if it generates `randomUUID()`, then `getStatus().automakerProjectId` won't match `projectId` unless we mock `randomUUID()` or `createOrResolveProject()` returns something and we use it, but `getStatus` is fixed!
+
+// In `import-github.ts`:
+// `const confirmed = await argusService.getStatus(canonicalPath);`
+// `if (!confirmed || confirmed.automakerProjectId !== projectId || !confirmed.argusProjectId)`
+// Since `projectId` is generated by `const projectId = randomUUID().replace(/-/g, '');` inside `createImportGithubHandler`, we can't hardcode it in the mock!
+// We can mock `randomUUID` to return a known value!
+
+testCode = testCode.replace(
+  `import { ensureArgusControlFiles } from '../../../../src/services/argus/project-lifecycle.js';`,
+  `import { ensureArgusControlFiles } from '../../../../src/services/argus/project-lifecycle.js';
+import { randomUUID } from 'crypto';
+vi.mock('crypto', async () => {
+  const actual = await vi.importActual('crypto');
+  return { ...actual, randomUUID: vi.fn(() => '1234567890abcdef1234567890abcdef') };
+});`
+);
+
+testCode = testCode.replace(
+  `getStatus: vi.fn().mockResolvedValue({ automakerProjectId: 'test-id', argusProjectId: 'argus-id' })`,
+  `getStatus: vi.fn().mockResolvedValue({ automakerProjectId: '1234567890abcdef1234567890abcdef', argusProjectId: 'argus-id' })`
+);
+
+// We need to fix the reference error for hoisted mocks
+testCode = testCode.replace(
+  `const { argusServiceMock, autonomyRunnerMock } = vi.hoisted(() => ({`,
+  `const mocks = vi.hoisted(() => ({`
+);
+testCode = testCode.replace(`argusServiceMock: {`, `argusServiceMock: {`);
+
+testCode = testCode.replace(/argusServiceMock\.start/g, 'mocks.argusServiceMock.start');
+testCode = testCode.replace(/argusServiceMock\.getStatus/g, 'mocks.argusServiceMock.getStatus');
+testCode = testCode.replace(/autonomyRunnerMock = /g, 'mocks.autonomyRunnerMock = ');
+testCode = testCode.replace(/autonomyRunnerMock\./g, 'mocks.autonomyRunnerMock.');
+
+testCode = testCode.replace(
+  `vi.mock('../../../../src/services/argus/runtime.js', () => ({
+  argusService: argusServiceMock
+}));
+
+vi.mock('../../../../src/services/argus/autonomy-runtime.js', () => ({
+  getArgusAutonomyRunner: vi.fn(() => autonomyRunnerMock)
+}));`,
+  `vi.mock('../../../../src/services/argus/runtime.js', () => ({
+  argusService: mocks.argusServiceMock
+}));
+
+vi.mock('../../../../src/services/argus/autonomy-runtime.js', () => ({
+  getArgusAutonomyRunner: vi.fn(() => mocks.autonomyRunnerMock)
+}));`
+);
+
+fs.writeFileSync('apps/server/tests/unit/routes/projects/import-github.test.ts', testCode);
