+const fs = require('fs');
+
+let testCode = fs.readFileSync(
+  'apps/server/tests/unit/routes/projects/import-github.test.ts',
+  'utf8'
+);
+
+// The output from PROJECT ID PASSED TO MOCK was NOT printed!
+// Wait! I did NOT see `PROJECT ID PASSED TO MOCK` in the stdout!
+// Ah. The test is failing with ARGUS_REGISTRATION_UNVERIFIED, but `createOrResolveProject` wasn't even called!
+// Let's check `import-github.ts`:
+/*
+      try {
+        const canonicalPath = await fs.realpath(projectPath);
+        if (canonicalPath !== projectPath) throw new Error('IMPORT_PATH_IDENTITY_MISMATCH');
+        // Test environment does not run git clone, so .git might be absent
+        if (process.env.NODE_ENV !== 'test') await fs.stat(path.join(canonicalPath, '.git'));
+        await ensureArgusControlFiles(canonicalPath, '', req.body?.overview || '');
+
+        await argusService.start();
+        await argusService.createOrResolveProject({ ... });
+*/
+// Wait! `await argusService.start()` was called! We saw `Error: Argus bridge crash` in one of the tests.
+// BUT why wasn't `createOrResolveProject` called in the success tests?
+// Did it throw an error before `createOrResolveProject`?
+// Yes! `await ensureArgusControlFiles(canonicalPath, '', req.body?.overview || '');`
+// Is `ensureArgusControlFiles` mocked? Yes!
+// `vi.mock('../../../../src/services/argus/project-lifecycle.js', () => ({ ensureArgusControlFiles: vi.fn() }));`
+// Does it return a promise? `vi.fn()` returns undefined by default, so `await vi.fn()` resolves to undefined. That's fine.
+
+// What if `fs.realpath(projectPath)` throws an error?
+// No, the mock returns the string.
+
+// What if `canonicalPath !== projectPath`?
+// Oh!
+// In `import-github.test.ts`:
+// `root = await fs.mkdtemp(path.join(os.tmpdir(), 'import-security-'));`
+// Our mocked `realpath` returns exactly what is passed.
+// `projectPath` inside `import-github.ts` is `path.join(parentDir, projectName)`.
+// `realpath` mock returns the exact same thing. So they should match.
+
+// Let's print the EXACT error from `catch (err)` inside `import-github.ts`. Wait! We DID!
+// `console.error('Failed to initialize Argus for imported project:', err);`
+// It printed:
+// `Failed to initialize Argus for imported project: Error: ARGUS_REGISTRATION_UNVERIFIED`
+// So it DID reach `if (!confirmed || confirmed.automakerProjectId !== projectId || !confirmed.argusProjectId) { throw new Error('ARGUS_REGISTRATION_UNVERIFIED'); }`!!!
+
+// So why didn't `console.log('PROJECT ID PASSED TO MOCK:', opts.projectId)` print anything?
+// Ah! In vitest, `console.log` from mocked functions might be swallowed or printed elsewhere if it's executed in a different context or if we just missed it in the `stderr` block?
+// The mock IS being executed!
+
+// Let's force `getStatus` to ALWAYS return the correct `projectId` dynamically using `vi.mock` factory.
+// We can use `const projectId = Array.from(mocks.argusServiceMock.createOrResolveProject.mock.calls)[0][0].projectId` inside `getStatus`!
+
+testCode = testCode.replace(
+  `getStatus: vi.fn().mockImplementation(async () => {
+          return { automakerProjectId: lastProjectId, argusProjectId: 'argus-id' };
+        })`,
+  `getStatus: vi.fn().mockImplementation(async () => {
+          const calls = mocks.argusServiceMock.createOrResolveProject.mock.calls;
+          const pid = calls.length > 0 ? calls[calls.length - 1][0].projectId : 'unknown';
+          return { automakerProjectId: pid, argusProjectId: 'argus-id' };
+        })`
+);
+
+fs.writeFileSync('apps/server/tests/unit/routes/projects/import-github.test.ts', testCode);
